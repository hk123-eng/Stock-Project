{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "Logs", "Effect": "Allow", "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
     "Resource": ["arn:aws:logs:ap-south-1:542601847637:log-group:/aws/lambda/stock-signals", "arn:aws:logs:ap-south-1:542601847637:log-group:/aws/lambda/stock-signals:*"]},
    {"Sid": "ReadPrices", "Effect": "Allow", "Action": "dynamodb:Query",
     "Resource": "arn:aws:dynamodb:ap-south-1:542601847637:table/stock-prices"},
    {"Sid": "WriteSignals", "Effect": "Allow", "Action": "dynamodb:UpdateItem",
     "Resource": "arn:aws:dynamodb:ap-south-1:542601847637:table/stock-signals"}
  ]
}
