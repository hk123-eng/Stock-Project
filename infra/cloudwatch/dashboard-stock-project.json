 "widgets": [
  {
   "type": "text",
   "x": 0,
   "y": 0,
   "width": 24,
   "height": 2,
   "properties": {
    "markdown": "## stock-project (ap-south-1)\nDaily watchlist pipeline AAPL MSFT GOOGL AMZN NVDA on real, unadjusted Alpha Vantage prices. Only AAPL has a model: **experimental, does not beat the naive baseline**. Model-health metrics come from live scored predictions only; no verdict below 20 scored days (see GET /model-health). Legacy synthetic rows are never used."
   }
  },
  {
   "type": "metric",
   "x": 0,
   "y": 2,
   "width": 8,
   "height": 6,
   "properties": {
    "title": "Step Functions executions (daily)",
    "region": "ap-south-1",
    "metrics": [
     [
      "AWS/States",
      "ExecutionsSucceeded",
      "StateMachineArn",
      "arn:aws:states:ap-south-1:542601847637:stateMachine:stock-prediction-pipeline"
     ],
     [
      "AWS/States",
      "ExecutionsFailed",
      "StateMachineArn",
      "arn:aws:states:ap-south-1:542601847637:stateMachine:stock-prediction-pipeline"
     ],
     [
      "AWS/States",
      "ExecutionsTimedOut",
      "StateMachineArn",
      "arn:aws:states:ap-south-1:542601847637:stateMachine:stock-prediction-pipeline"
     ]
    ],
    "stat": "Sum",
    "period": 86400,
    "view": "timeSeries"
   }
