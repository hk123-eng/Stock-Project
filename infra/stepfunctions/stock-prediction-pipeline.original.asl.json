{"Comment":"Daily stock prediction pipeline: invoke Lambda, publish SNS on success or failure.","StartAt":"InvokeInference","States":{"InvokeInference":{"Type":"Task","Resource":"arn:aws:lambda:ap-south-1:542601847637:function:stock-lstm-inference","Parameters":{"symbol.$":"$.symbol"},"Retry":[{"ErrorEquals":["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException","Lambda.TooManyRequestsException"],"IntervalSeconds":5,"MaxAttempts":2,"BackoffRate":2}],"Catch":[{"ErrorEquals":["States.ALL"],"ResultPath":"$.error","Next":"PublishFailure"}],"Next":"CheckResult"},"CheckResult":{"Type":"Choice","Choices":[{"Variable":"$.statusCode","NumericEquals":200,"Next":"PublishSuccess"}],"Default":"PublishFailure"},"PublishSuccess":{"Type":"Task","Resource":"arn:aws:states:::sns:publish","Parameters":{"TopicArn":"arn:aws:sns:ap-south-1:542601847637:stock-prediction-alerts","Subject":"Stock Prediction Success","Message.$":"States.Format('Symbol: {}\nPrediction: {}\nTimestamp: {}', $.symbol, $.prediction, $$.Execution.StartTime)"},"Next":"Succeed"},"PublishFailure":{"Type":"Task","Resource":"arn:aws:states:::sns:publish","Parameters":{"TopicArn":"arn:aws:sns:ap-south-1:542601847637:stock-prediction-alerts","Subject":"Stock Prediction Failure","Message.$":"States.Format('The stock prediction pipeline failed.\nExecution: {}\nError: {}', $$.Execution.Id, $.error)"},"Next":"Fail"},"Succeed":{"Type":"Succeed"},"Fail":{"Type":"Fail","Error":"PipelineFailed","Cause":"See SNS alert for details"}}}
